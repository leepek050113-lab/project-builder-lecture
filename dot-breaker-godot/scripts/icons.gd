extends RefCounted
## 16x16 icons drawn in code from the game palette (adapted from Pipstar's icon kit):
## upgrades are casino chips with a 6x6 emblem, balls are toon-shaded spheres. Dark 1px outline on all.

const Data := preload("res://scripts/data.gd")
const SIZE := 16
const LIGHT := Vector3(-0.6, -0.65, 0.5)

static var pal: Array[Color] = []
static var _cache := {}


static func get_icon(kind: String, id: String) -> ImageTexture:
	var key := kind + ":" + id
	if not _cache.has(key):
		_cache[key] = ImageTexture.create_from_image(draw(kind, id))
	return _cache[key]


static func draw(kind: String, id: String) -> Image:
	var img := Image.create(SIZE, SIZE, false, Image.FORMAT_RGBA8)
	img.fill(Color(0, 0, 0, 0))
	match kind:
		"upgrade":
			_chip(img, Data.upgrade(id))
		"ball":
			_ball(img, id)
	_outline(img)
	return img


# ------------------------------------------------------------------ primitives

static func _px(img: Image, x: int, y: int, c: int) -> void:
	if x >= 0 and y >= 0 and x < SIZE and y < SIZE:
		img.set_pixel(x, y, pal[c])


static func _rect(img: Image, x: int, y: int, w: int, h: int, c: int) -> void:
	for yy in range(y, y + h):
		for xx in range(x, x + w):
			_px(img, xx, yy, c)


static func _disc(img: Image, cx: float, cy: float, r: float, light: int, base: int, dark: int) -> void:
	var ldir := LIGHT.normalized()
	for y in SIZE:
		for x in SIZE:
			var dx := (x + 0.5 - cx) / r
			var dy := (y + 0.5 - cy) / r
			var d2 := dx * dx + dy * dy
			if d2 > 1.0:
				continue
			var n := Vector3(dx, dy, sqrt(1.0 - d2))
			var l := n.dot(ldir)
			_px(img, x, y, light if l > 0.55 else (base if l > -0.05 else dark))


## Dark 1px outline around everything opaque, like the dice's inverted-hull outline
static func _outline(img: Image) -> void:
	var src := img.duplicate()
	for y in SIZE:
		for x in SIZE:
			if src.get_pixel(x, y).a > 0.0:
				continue
			for o in [Vector2i(1, 0), Vector2i(-1, 0), Vector2i(0, 1), Vector2i(0, -1)]:
				var q: Vector2i = Vector2i(x, y) + o
				if q.x >= 0 and q.y >= 0 and q.x < SIZE and q.y < SIZE and src.get_pixelv(q).a > 0.0:
					img.set_pixel(x, y, pal[1])
					break


# ------------------------------------------------------------------ balls

## Toon-shaded sphere in the ball's colors, with a mark for the special ones
static func _ball(img: Image, id: String) -> void:
	var col: Array = Data.ball(id).col
	_disc(img, 8, 8, 6.2, col[0], col[1], col[2])
	match id:
		"bomb":
			_rect(img, 9, 1, 2, 2, 13)
			_px(img, 11, 0, 12)
		"drill":
			for i in 5:
				_px(img, 5 + i, 10 - i, 4)
		"split":
			for i in 9:
				_px(img, 8, 4 + i, 14)
		"spark":
			for p in [[9, 4], [8, 5], [7, 6], [8, 7], [9, 8], [8, 9], [7, 10]]:
				_px(img, p[0], p[1], 13)
		"ghost":
			_rect(img, 6, 7, 1, 2, 2)
			_rect(img, 9, 7, 1, 2, 2)
		"laser":
			_rect(img, 5, 8, 7, 1, 8)
		"cluster":
			for p in [[6, 6], [10, 7], [7, 10], [10, 10]]:
				_px(img, p[0], p[1], 10)
		"vampire":
			_px(img, 7, 10, 8)
			_px(img, 9, 10, 8)
		"prism":
			_rect(img, 6, 6, 2, 2, 8)
			_rect(img, 9, 9, 2, 2, 18)
		"void":
			_disc(img, 8, 8, 3.0, 18, 4, 2)
		"nova":
			for p in [[8, 3], [8, 13], [3, 8], [13, 8]]:
				_px(img, p[0], p[1], 8)
		"comet":
			_rect(img, 1, 12, 3, 1, 18)
			_rect(img, 2, 13, 2, 1, 17)
		"midas":
			_rect(img, 6, 5, 5, 1, 12)
			_px(img, 6, 4, 12)
			_px(img, 8, 4, 12)
			_px(img, 10, 4, 12)
		"lucky":
			_px(img, 8, 7, 8)
			_px(img, 7, 8, 8)
			_px(img, 9, 8, 8)


