## Chip seen slightly from above: dark edge below, rim striped in the rarity color, light inlay, emblem
static func _chip(img: Image, def: Dictionary) -> void:
	var col: Array = CHIP_COLORS.get(def.get("chip", "mult"), CHIP_COLORS["mult"])
	if def.has("for"):
		# a ball's own upgrade wears that ball's colors
		var bc: Array = Data.ball(def.for).col
		col = [bc[1], bc[2], bc[2]]
	var stripe: int = STRIPE.get(def.get("rarity", "C"), 8)
	var c := Vector2(8.0, 7.5)   # the 6x6 emblem sits at x 5..10, y 4..9
	var r := 6.4
	var ldir := Vector2(-0.7, -0.7)
	for y in SIZE:
		for x in SIZE:
			var p := Vector2(x + 0.5, y + 0.5)
			if p.distance_to(c + Vector2(0, 1.2)) <= r and p.distance_to(c) > r:
				_px(img, x, y, col[1])   # chip thickness
			var d := p.distance_to(c)
			if d > r:
				continue
			var lit := (p - c).normalized().dot(ldir) if d > 0.01 else 1.0
			if d > r - 1.3:
				var ang := atan2(p.y - c.y, p.x - c.x) + PI / 8.0
				var a := fposmod(ang, TAU / 8.0)
				if a < TAU / 8.0 * 0.34:
					_px(img, x, y, stripe)
				else:
					_px(img, x, y, col[0] if lit > -0.4 else col[1])
			elif d > r - 1.9:
				_px(img, x, y, col[1])
			else:
				_px(img, x, y, 8 if lit > 0.3 and d > r - 2.9 else 7)
	var e: Array = GLYPHS.get(def.get("glyph", "smile"), GLYPHS["smile"])
	for row in 6:
		for k in 6:
			if e[row][k] == "#":
				_px(img, 5 + k, 4 + row, col[2])
